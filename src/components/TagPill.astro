---
interface Props {
  slug: string;
  name?: string;
}

const { slug, name } = Astro.props;
---

<a
  href={`/tags/${slug}`}
  class="mr-2 inline-block text-sm font-medium tracking-wide text-primary-600 uppercase hover:text-primary-500 dark:text-primary-400 dark:hover:text-primary-300"
>
  {name ?? slug.replaceAll('-', ' ')}
</a>
