---
/**
 * Decorative desktop-only effect: columns of this site's own source code in
 * the left and right gutters, drifting with a parallax feel. The columns are
 * fixed to the viewport and a scroll-driven animation slides them up by a
 * set distance (--cg-drift) over the page's full scroll range, so the code
 * moves slower than the content and never runs out on long pages. Fixed
 * "fog" patches in the page background color sit on top; as the code drifts
 * behind them, lines fade in and out through the soft gaps.
 *
 * Browsers without scroll-driven animation support (Safari before 26) get
 * the same drift from a small scroll listener instead; the script exits
 * immediately where the CSS path works. Reduced-motion users get calm,
 * stationary columns either way. Purely ornamental: hidden from assistive
 * tech and search, non-interactive. Shown only at xl and up; below that,
 * the Hero side strips carry the effect instead. Snippets and highlighter
 * live in src/lib/gutter-code.ts.
 */
import GutterCode from '@/components/GutterCode.astro';
import { SNIPPETS } from '@/lib/gutter-code';

// Columns only need to cover one viewport plus the drift distance, so a
// handful of repeats is enough regardless of how long the page is.
const REPEATS = 7;
const leftCode = Array(REPEATS).fill(`${SNIPPETS.schema}\n\n${SNIPPETS.posts}`).join('\n\n');
const rightCode = Array(REPEATS).fill(`${SNIPPETS.theme}\n\n${SNIPPETS.graph}`).join('\n\n');
---

<div class="code-gutters hidden xl:block" aria-hidden="true" data-pagefind-ignore>
  <div class="cg-col cg-col--left"><GutterCode code={leftCode} /></div>
  <div class="cg-col cg-col--right"><GutterCode code={rightCode} /></div>

  {/* Fog stays put while the code drifts behind it. */}
  <div class="cg-fog cg-fog--left"></div>
  <div class="cg-fog cg-fog--right"></div>
</div>

<style>
  .code-gutters {
    pointer-events: none;
  }

  .cg-col {
    --cg-drift: 1200px;
    position: fixed;
    top: 0;
    z-index: 0;
    height: calc(100vh + var(--cg-drift));
    width: min(360px, max(0px, calc((100vw - 48rem) / 2)));
    overflow: hidden;
    user-select: none;
    opacity: 0.6;
  }

  /* Slower than the content: the column slides up by --cg-drift across the
     page's entire scroll range. Gated so browsers without scroll-driven
     animations keep calm, stationary columns. Longhands on purpose: the CSS
     minifier folds animation-timeline into an animation shorthand, which is
     invalid and makes the browser drop the whole declaration. */
  @supports (animation-timeline: scroll()) {
    .cg-col {
      animation-name: cg-drift;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root);
    }
  }

  @keyframes cg-drift {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(calc(-1 * var(--cg-drift)));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cg-col {
      animation: none;
    }
  }

  :global(.dark) .cg-col {
    opacity: 0.5;
  }

  .cg-col--left {
    left: 0;
    /* Fade toward the reading column (inner/right edge). */
    -webkit-mask-image: linear-gradient(to right, #000 0%, #000 20%, transparent 92%);
    mask-image: linear-gradient(to right, #000 0%, #000 20%, transparent 92%);
  }

  .cg-col--right {
    right: 0;
    -webkit-mask-image: linear-gradient(to left, #000 0%, #000 20%, transparent 92%);
    mask-image: linear-gradient(to left, #000 0%, #000 20%, transparent 92%);
  }

  /* Fixed fog: the code drifts behind it. Same color as the page
     background, with soft radial patches and transparent gaps. */
  .cg-fog {
    position: fixed;
    top: 0;
    bottom: 0;
    z-index: 1;
    pointer-events: none;
    width: min(360px, max(0px, calc((100vw - 48rem) / 2)));
    --fog: var(--color-white);
  }

  :global(.dark) .cg-fog {
    --fog: var(--color-zinc-950);
  }

  /* Blob sizes, positions, and edge softness are deliberately irregular
     (overlapping clumps, jittered spacing) so the fog reads as natural
     drift instead of even horizontal bands. */
  .cg-fog--left {
    left: 0;
    background:
      radial-gradient(120% 10% at 30% 3%, var(--fog) 0%, var(--fog) 35%, transparent 70%),
      radial-gradient(70% 16% at 72% 11%, var(--fog) 0%, var(--fog) 40%, transparent 78%),
      radial-gradient(150% 8% at 42% 23%, var(--fog) 0%, var(--fog) 30%, transparent 64%),
      radial-gradient(90% 20% at 24% 38%, var(--fog) 0%, var(--fog) 46%, transparent 82%),
      radial-gradient(55% 12% at 80% 46%, var(--fog) 0%, var(--fog) 36%, transparent 70%),
      radial-gradient(140% 14% at 52% 61%, var(--fog) 0%, var(--fog) 42%, transparent 74%),
      radial-gradient(75% 9% at 18% 73%, var(--fog) 0%, var(--fog) 32%, transparent 68%),
      radial-gradient(110% 18% at 66% 86%, var(--fog) 0%, var(--fog) 44%, transparent 80%),
      radial-gradient(80% 10% at 34% 98%, var(--fog) 0%, var(--fog) 36%, transparent 72%);
  }

  .cg-fog--right {
    right: 0;
    background:
      radial-gradient(85% 14% at 62% 5%, var(--fog) 0%, var(--fog) 42%, transparent 76%),
      radial-gradient(130% 8% at 28% 16%, var(--fog) 0%, var(--fog) 30%, transparent 66%),
      radial-gradient(65% 18% at 74% 29%, var(--fog) 0%, var(--fog) 44%, transparent 80%),
      radial-gradient(145% 10% at 44% 42%, var(--fog) 0%, var(--fog) 34%, transparent 68%),
      radial-gradient(75% 13% at 22% 54%, var(--fog) 0%, var(--fog) 38%, transparent 74%),
      radial-gradient(100% 19% at 68% 68%, var(--fog) 0%, var(--fog) 46%, transparent 82%),
      radial-gradient(60% 9% at 38% 79%, var(--fog) 0%, var(--fog) 32%, transparent 66%),
      radial-gradient(125% 15% at 56% 93%, var(--fog) 0%, var(--fog) 42%, transparent 78%);
  }
</style>

<script>
  // Parallax fallback for browsers without CSS scroll-driven animations
  // (Safari before 26): reproduce the drift with a scroll listener. Where
  // the CSS path works this exits before touching anything. The scroll
  // listener lives on the persistent document, so it survives ClientRouter
  // swaps; astro:page-load re-syncs after each navigation (fresh columns,
  // reset scroll position).
  if (
    !CSS.supports('animation-timeline: scroll()') &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    const update = () => {
      const cols = document.querySelectorAll<HTMLElement>('.cg-col');
      if (!cols.length) return;
      const drift = parseFloat(getComputedStyle(cols[0]!).getPropertyValue('--cg-drift')) || 0;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const progress = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      for (const col of cols) {
        col.style.transform = `translateY(${-progress * drift}px)`;
      }
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        update();
      });
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    document.addEventListener('astro:page-load', update);
    update();
  }
</script>
