---
/**
 * Decorative desktop-only effect: columns of this site's own source code in
 * the left and right gutters, drifting with a parallax feel. The columns are
 * fixed to the viewport and a scroll-driven animation slides them up by a
 * set distance (--cg-drift) over the page's full scroll range, so the code
 * moves slower than the content and never runs out on long pages. Fixed
 * "fog" patches in the page background color sit on top; as the code drifts
 * behind them, lines fade in and out through the soft gaps.
 *
 * Browsers without scroll-driven animation support simply ignore
 * animation-timeline and get calm, stationary columns; reduced-motion users
 * get the same. Purely ornamental: hidden from assistive tech and search,
 * non-interactive, no client JS. Shown only at xl and up; below that, the
 * Hero side strips carry the effect instead. Snippets and highlighter live
 * in src/lib/gutter-code.ts.
 */
import GutterCode from '@/components/GutterCode.astro';
import { SNIPPETS } from '@/lib/gutter-code';

// Columns only need to cover one viewport plus the drift distance, so a
// handful of repeats is enough regardless of how long the page is.
const REPEATS = 7;
const leftCode = Array(REPEATS).fill(`${SNIPPETS.schema}\n\n${SNIPPETS.posts}`).join('\n\n');
const rightCode = Array(REPEATS).fill(`${SNIPPETS.theme}\n\n${SNIPPETS.graph}`).join('\n\n');
---

<div class="code-gutters hidden xl:block" aria-hidden="true" data-pagefind-ignore>
  <div class="cg-col cg-col--left"><GutterCode code={leftCode} /></div>
  <div class="cg-col cg-col--right"><GutterCode code={rightCode} /></div>

  {/* Fog stays put while the code drifts behind it. */}
  <div class="cg-fog cg-fog--left"></div>
  <div class="cg-fog cg-fog--right"></div>
</div>

<style>
  .code-gutters {
    pointer-events: none;
  }

  .cg-col {
    --cg-drift: 1200px;
    position: fixed;
    top: 0;
    z-index: 0;
    height: calc(100vh + var(--cg-drift));
    width: min(360px, max(0px, calc((100vw - 48rem) / 2)));
    overflow: hidden;
    user-select: none;
    opacity: 0.6;
  }

  /* Slower than the content: the column slides up by --cg-drift across the
     page's entire scroll range. Gated so browsers without scroll-driven
     animations keep calm, stationary columns. Longhands on purpose: the CSS
     minifier folds animation-timeline into an animation shorthand, which is
     invalid and makes the browser drop the whole declaration. */
  @supports (animation-timeline: scroll()) {
    .cg-col {
      animation-name: cg-drift;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root);
    }
  }

  @keyframes cg-drift {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(calc(-1 * var(--cg-drift)));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cg-col {
      animation: none;
    }
  }

  :global(.dark) .cg-col {
    opacity: 0.5;
  }

  .cg-col--left {
    left: 0;
    /* Fade toward the reading column (inner/right edge). */
    -webkit-mask-image: linear-gradient(to right, #000 0%, #000 20%, transparent 92%);
    mask-image: linear-gradient(to right, #000 0%, #000 20%, transparent 92%);
  }

  .cg-col--right {
    right: 0;
    -webkit-mask-image: linear-gradient(to left, #000 0%, #000 20%, transparent 92%);
    mask-image: linear-gradient(to left, #000 0%, #000 20%, transparent 92%);
  }

  /* Fixed fog: the code drifts behind it. Same color as the page
     background, with soft radial patches and transparent gaps. */
  .cg-fog {
    position: fixed;
    top: 0;
    bottom: 0;
    z-index: 1;
    pointer-events: none;
    width: min(360px, max(0px, calc((100vw - 48rem) / 2)));
    --fog: var(--color-white);
  }

  :global(.dark) .cg-fog {
    --fog: var(--color-zinc-950);
  }

  .cg-fog--left {
    left: 0;
    background:
      radial-gradient(135% 13% at 42% 6%, var(--fog) 0%, var(--fog) 42%, transparent 74%),
      radial-gradient(135% 18% at 58% 27%, var(--fog) 0%, var(--fog) 45%, transparent 78%),
      radial-gradient(135% 11% at 32% 48%, var(--fog) 0%, var(--fog) 40%, transparent 72%),
      radial-gradient(135% 19% at 60% 70%, var(--fog) 0%, var(--fog) 46%, transparent 80%),
      radial-gradient(135% 14% at 36% 92%, var(--fog) 0%, var(--fog) 42%, transparent 76%);
  }

  .cg-fog--right {
    right: 0;
    background:
      radial-gradient(135% 12% at 55% 10%, var(--fog) 0%, var(--fog) 40%, transparent 72%),
      radial-gradient(135% 17% at 40% 33%, var(--fog) 0%, var(--fog) 45%, transparent 78%),
      radial-gradient(135% 13% at 62% 55%, var(--fog) 0%, var(--fog) 42%, transparent 74%),
      radial-gradient(135% 18% at 38% 76%, var(--fog) 0%, var(--fog) 46%, transparent 80%),
      radial-gradient(135% 12% at 58% 96%, var(--fog) 0%, var(--fog) 40%, transparent 72%);
  }
</style>
