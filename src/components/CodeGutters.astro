---
/**
 * Decorative desktop-only effect: columns of this site's own source code in
 * the left and right gutters, drifting with a parallax feel. The columns
 * are fixed to the viewport and a scroll listener slides them up by a set
 * distance (--cg-drift) over the page's full scroll range, so the code
 * moves slower than the content and never runs out on long pages. Fixed
 * "fog" patches in the page background color sit on top; as the code
 * drifts behind them, lines fade in and out through the soft gaps.
 *
 * The drift is driven by JS in every browser on purpose. A CSS
 * scroll-driven animation looked ideal and worked in Chrome, but Safari
 * passes the animation-timeline feature check without reliably animating
 * fixed, masked elements, so feature detection picks the broken path
 * (and the CSS minifier folds animation-timeline into an invalid
 * animation shorthand that kills the declaration outright). One tiny
 * scroll listener behaves identically everywhere.
 *
 * Purely ornamental: hidden from assistive tech and search,
 * non-interactive, static without JS or under reduced motion. Shown only
 * at xl and up; below that, the Hero side strips carry the effect
 * instead. Snippets and highlighter live in src/lib/gutter-code.ts.
 */
import GutterCode from '@/components/GutterCode.astro';
import { SNIPPETS } from '@/lib/gutter-code';

// Columns only need to cover one viewport plus the drift distance, so a
// handful of repeats is enough regardless of how long the page is.
const REPEATS = 7;
const leftCode = Array(REPEATS).fill(`${SNIPPETS.schema}\n\n${SNIPPETS.posts}`).join('\n\n');
const rightCode = Array(REPEATS).fill(`${SNIPPETS.theme}\n\n${SNIPPETS.graph}`).join('\n\n');
---

<div class="code-gutters hidden xl:block" aria-hidden="true" data-pagefind-ignore>
  <div class="cg-col cg-col--left"><GutterCode code={leftCode} /></div>
  <div class="cg-col cg-col--right"><GutterCode code={rightCode} /></div>

  {/* Fog stays put while the code drifts behind it. */}
  <div class="cg-fog cg-fog--left"></div>
  <div class="cg-fog cg-fog--right"></div>
</div>

<style>
  .code-gutters {
    pointer-events: none;
  }

  .cg-col {
    --cg-drift: 1200px;
    position: fixed;
    top: 0;
    z-index: 0;
    height: calc(100vh + var(--cg-drift));
    width: min(360px, max(0px, calc((100vw - 48rem) / 2)));
    overflow: hidden;
    user-select: none;
    opacity: 0.6;
    will-change: transform;
  }

  :global(.dark) .cg-col {
    opacity: 0.5;
  }

  .cg-col--left {
    left: 0;
    /* Fade toward the reading column (inner/right edge). */
    -webkit-mask-image: linear-gradient(to right, #000 0%, #000 20%, transparent 92%);
    mask-image: linear-gradient(to right, #000 0%, #000 20%, transparent 92%);
  }

  .cg-col--right {
    right: 0;
    -webkit-mask-image: linear-gradient(to left, #000 0%, #000 20%, transparent 92%);
    mask-image: linear-gradient(to left, #000 0%, #000 20%, transparent 92%);
  }

  /* Fixed fog: the code drifts behind it. Same color as the page
     background. Blob sizes, positions, and edge softness are deliberately
     irregular so the fog reads as natural drift instead of even bands,
     but each blob is large and wispy so reveals fade gently during
     scrolling instead of flickering. */
  .cg-fog {
    position: fixed;
    top: 0;
    bottom: 0;
    z-index: 1;
    pointer-events: none;
    width: min(360px, max(0px, calc((100vw - 48rem) / 2)));
    --fog: var(--color-white);
  }

  :global(.dark) .cg-fog {
    --fog: var(--color-zinc-950);
  }

  .cg-fog--left {
    left: 0;
    background:
      radial-gradient(160% 16% at 35% 5%, var(--fog) 0%, var(--fog) 30%, transparent 85%),
      radial-gradient(120% 22% at 65% 22%, var(--fog) 0%, var(--fog) 35%, transparent 88%),
      radial-gradient(170% 14% at 28% 42%, var(--fog) 0%, var(--fog) 28%, transparent 82%),
      radial-gradient(110% 20% at 70% 58%, var(--fog) 0%, var(--fog) 34%, transparent 86%),
      radial-gradient(150% 15% at 40% 76%, var(--fog) 0%, var(--fog) 30%, transparent 84%),
      radial-gradient(130% 18% at 60% 95%, var(--fog) 0%, var(--fog) 32%, transparent 86%);
  }

  .cg-fog--right {
    right: 0;
    background:
      radial-gradient(140% 18% at 60% 8%, var(--fog) 0%, var(--fog) 32%, transparent 86%),
      radial-gradient(165% 13% at 30% 27%, var(--fog) 0%, var(--fog) 28%, transparent 82%),
      radial-gradient(115% 21% at 68% 45%, var(--fog) 0%, var(--fog) 35%, transparent 88%),
      radial-gradient(155% 14% at 35% 63%, var(--fog) 0%, var(--fog) 30%, transparent 84%),
      radial-gradient(125% 19% at 65% 80%, var(--fog) 0%, var(--fog) 33%, transparent 86%),
      radial-gradient(145% 15% at 42% 97%, var(--fog) 0%, var(--fog) 30%, transparent 84%);
  }
</style>

<script>
  // Drives the drift (see the component comment for why this is JS in
  // every browser). The listeners live on the persistent window and
  // document, so they survive ClientRouter swaps; astro:page-load
  // re-syncs each new page (fresh columns, restored scroll position).
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const desktop = window.matchMedia('(min-width: 80rem)'); // Tailwind xl

  function update() {
    if (reduceMotion.matches || !desktop.matches) return;
    const cols = document.querySelectorAll<HTMLElement>('.cg-col');
    if (!cols.length) return;
    const drift = parseFloat(getComputedStyle(cols[0]!).getPropertyValue('--cg-drift')) || 0;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const progress = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    for (const col of cols) {
      col.style.transform = `translateY(${-progress * drift}px)`;
    }
  }

  let ticking = false;
  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      ticking = false;
      update();
    });
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  document.addEventListener('astro:page-load', update);
  update();
</script>
