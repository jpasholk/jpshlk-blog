---
/**
 * Anchor that opens external URLs in a new tab with an external-link
 * marker. Blog post MDX imports this by path, so `href` + `class`
 * (via HTMLAttributes) must stay supported.
 */
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...rest } = Astro.props;
const isExternal =
  typeof href === 'string' && !href.startsWith('/') && !href.startsWith('#');
---

{
  isExternal ? (
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class:list={['underline-offset-2 hover:underline', className]}
      {...rest}
    >
      <slot />
      {/* width/height mirror size-4 (16px) for contexts without site
          CSS, like feed readers; data-feed-strip lets rss.xml.ts drop
          this icon from feed HTML without matching on class names. */}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 20 20"
        width="16"
        height="16"
        fill="currentColor"
        aria-hidden="true"
        data-feed-strip
        class="inline size-4 align-text-top"
      >
        <path
          fill-rule="evenodd"
          d="M4.25 5.5a.75.75 0 0 0-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 0 0 .75-.75v-4a.75.75 0 0 1 1.5 0v4A2.25 2.25 0 0 1 12.75 17h-8.5A2.25 2.25 0 0 1 2 14.75v-8.5A2.25 2.25 0 0 1 4.25 4h5a.75.75 0 0 1 0 1.5h-5Z"
          clip-rule="evenodd"
        />
        <path
          fill-rule="evenodd"
          d="M6.194 12.753a.75.75 0 0 0 1.06.053L16.5 4.44v2.81a.75.75 0 0 0 1.5 0v-4.5a.75.75 0 0 0-.75-.75h-4.5a.75.75 0 0 0 0 1.5h2.553l-9.056 8.194a.75.75 0 0 0-.053 1.06Z"
          clip-rule="evenodd"
        />
      </svg>
    </a>
  ) : (
    <a href={href} class:list={[className]} {...rest}>
      <slot />
    </a>
  )
}
