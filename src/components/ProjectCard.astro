---
/**
 * Project card for the /projects/ index (stacked) and the homepage
 * work section (horizontal: image beside text on wider screens).
 * The image and title carry the transition names that morph into the
 * detail page's hero and h1.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Card from '@/components/Card.astro';
import Button from '@/components/Button.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  headingLevel?: 'h2' | 'h3';
  imageWidth?: number;
  layout?: 'stacked' | 'horizontal';
}

const { project, headingLevel = 'h2', imageWidth = 800, layout = 'stacked' } = Astro.props;
const { id } = project;
const { title, description, url, linkLabel, image, imageAlt } = project.data;

const Heading = headingLevel;
const href = `/projects/${id}/`;
const horizontal = layout === 'horizontal';
---

<Card class={horizontal ? 'flex flex-col gap-6 sm:flex-row sm:items-center' : 'flex flex-col'}>
  {
    image && (
      <a
        href={href}
        aria-label={`View ${title}`}
        class={horizontal ? 'block sm:w-2/5 sm:flex-none' : 'mb-4 block'}
      >
        <Image
          src={image}
          alt={imageAlt ?? `A preview of ${title}`}
          width={imageWidth}
          class="rounded-lg"
          transition:name={`project-image-${id}`}
        />
      </a>
    )
  }
  <div class={horizontal ? 'flex min-w-0 flex-col' : 'contents'}>
    <Heading class="text-lg font-semibold">
      <a
        href={href}
        class="hover:text-primary-600 dark:hover:text-primary-400"
        transition:name={`project-title-${id}`}
      >
        {title}
      </a>
    </Heading>
    <p class="mt-2 grow text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
      {description}
    </p>
    <div class="mt-4 flex flex-wrap gap-3">
      <Button href={href} variant="primary">View project</Button>
      <Button href={url} variant="ghost">{linkLabel}</Button>
    </div>
  </div>
</Card>
