---
/**
 * Latest posts teaser. Placeholder cards until the blog collection
 * lands in Phase 3, when this switches to getCollection('blog').
 */
import Card from '@/components/Card.astro';

const placeholders = [
  { title: 'Blog posts arrive in Phase 3', summary: 'The existing 24 posts migrate here.' },
];
---

<section id="posts" class="mt-16 scroll-mt-8">
  <div class="flex items-baseline justify-between">
    <h2 class="text-2xl font-bold tracking-tight">Latest posts</h2>
    <a
      href="/blog"
      class="text-sm font-medium text-primary-600 hover:text-primary-500 dark:text-primary-400"
    >
      All posts &rarr;
    </a>
  </div>
  <div class="mt-6 space-y-4">
    {
      placeholders.map(({ title, summary }) => (
        <Card>
          <h3 class="text-lg font-semibold">{title}</h3>
          <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">{summary}</p>
        </Card>
      ))
    }
  </div>
</section>
