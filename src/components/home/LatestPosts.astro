---
import PostCard from '@/components/PostCard.astro';
import { POSTS_PER_PAGE } from '@/config';
import { getPublishedPosts } from '@/lib/posts';

const posts = (await getPublishedPosts()).slice(0, POSTS_PER_PAGE);
---

<section id="posts" class="mt-16 scroll-mt-8">
  <div class="flex items-baseline justify-between">
    <h2 class="text-2xl font-bold tracking-tight">Latest posts</h2>
    <a
      href="/blog/"
      class="text-sm font-medium text-primary-600 hover:text-primary-500 dark:text-primary-400"
    >
      All posts &rarr;
    </a>
  </div>
  <div class="mt-2 divide-y divide-zinc-200 dark:divide-zinc-800">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</section>
