---
/**
 * Featured work. Reads from the projects content collection once it
 * exists (Phase 3); until then renders a local data array with the
 * same shape so the section design can settle first.
 */
import Card from '@/components/Card.astro';
import Link from '@/components/Link.astro';
import { SOCIALS } from '@/config';

const projects = [
  {
    title: 'Plantonix',
    description:
      'My day job: running web and marketing operations for an Amazon and Shopify based gardening supply business — marketing strategy, product development, and the occasional fire drill.',
    url: 'https://plantonix.com',
    linkLabel: 'plantonix.com',
  },
  {
    title: 'Jekyll UiKit',
    description:
      'A Jekyll theme built on the UIkit front-end framework — a clean starter for static sites with UIkit components wired in.',
    url: 'https://github.com/jpasholk/jekyll-uikit',
    linkLabel: 'View on GitHub',
  },
  {
    title: 'iOS Shortcuts',
    description:
      'Automations for iPhone and Mac built with the Shortcuts app — utilities, toolkits, and experiments published on RoutineHub.',
    url: SOCIALS.routinehub,
    linkLabel: 'RoutineHub profile',
  },
];
---

<section id="work" class="mt-16 scroll-mt-8">
  <h2 class="text-2xl font-bold tracking-tight">My work</h2>
  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      projects.map(({ title, description, url, linkLabel }) => (
        <Card class="flex flex-col">
          <h3 class="text-lg font-semibold">{title}</h3>
          <p class="mt-2 grow text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
            {description}
          </p>
          <p class="mt-4">
            <Link
              href={url}
              class="text-sm font-medium text-primary-600 hover:text-primary-500 dark:text-primary-400"
            >
              {linkLabel}
            </Link>
          </p>
        </Card>
      ))
    }
  </div>
</section>
