---
import { getCollection } from 'astro:content';
import Card from '@/components/Card.astro';
import Link from '@/components/Link.astro';

const projects = (await getCollection('projects', ({ data }) => data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section id="work" class="mt-16 scroll-mt-8">
  <div class="flex items-baseline justify-between">
    <h2 class="text-2xl font-bold tracking-tight">My work</h2>
    <a
      href="/projects/"
      class="text-sm font-medium text-primary-600 hover:text-primary-500 dark:text-primary-400"
    >
      All projects &rarr;
    </a>
  </div>
  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      projects.map(({ data }) => (
        <Card class="flex flex-col">
          <h3 class="text-lg font-semibold">{data.title}</h3>
          <p class="mt-2 grow text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
            {data.description}
          </p>
          <p class="mt-4">
            <Link
              href={data.url}
              class="text-sm font-medium text-primary-600 hover:text-primary-500 dark:text-primary-400"
            >
              {data.linkLabel}
            </Link>
          </p>
        </Card>
      ))
    }
  </div>
</section>
