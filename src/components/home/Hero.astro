---
import { Image } from 'astro:assets';
import avatar from '@/assets/josh.jpeg';
import Button from '@/components/Button.astro';
import GutterCode from '@/components/GutterCode.astro';
import { AUTHOR } from '@/config';
import { highlight, SNIPPETS } from '@/lib/gutter-code';

// Pool for the per-visit shuffle (see the hero-code script in
// BaseLayout.astro): every snippet, pre-highlighted at build time.
const heroCodePool = Object.values(SNIPPETS).map((code) => highlight(code));
---

<section class="relative isolate flex flex-col-reverse items-center gap-8 pt-10 sm:flex-row sm:items-start sm:justify-between sm:pt-16">
  {/* Mobile/tablet slice of the code-in-the-margins effect: faint code
      peeking in from the hero's sides, masked hard toward the middle so it
      never sits behind the text. Desktop (xl+) gets CodeGutters instead.
      The rendered snippets are only the no-JS default: a BaseLayout script
      swaps in a random pair from the pool below on every visit. */}
  <div class="hero-code hero-code--left xl:hidden" aria-hidden="true" data-pagefind-ignore data-hero-code="left">
    <GutterCode code={SNIPPETS.posts} />
  </div>
  <div class="hero-code hero-code--right xl:hidden" aria-hidden="true" data-pagefind-ignore data-hero-code="right">
    <GutterCode code={SNIPPETS.theme} />
  </div>
  <script type="application/json" data-hero-code-pool set:html={JSON.stringify(heroCodePool)} />

  <div class="max-w-xl text-center sm:text-left">
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
      👋 I'm Josh
    </h1>
    <p class="mt-3 text-lg font-medium text-primary-600 dark:text-primary-400">
      {AUTHOR.occupation} @ {AUTHOR.company}
    </p>
    <p class="mt-4 text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">
      I run web and marketing operations for an Amazon and Shopify based
      business, blog about iPhone and Mac apps, and build fun things with
      iOS Shortcuts.
    </p>
    <div class="mt-6 flex justify-center gap-3 sm:justify-start">
      <Button href="/blog/">Read the blog</Button>
      <Button href="#work" variant="ghost">See my work</Button>
    </div>
  </div>
  <Image
    src={avatar}
    alt={`Portrait of ${AUTHOR.name}`}
    width={320}
    densities={[1, 2]}
    loading="eager"
    class="size-36 rounded-full object-cover ring-4 ring-primary-500/20 sm:size-40"
  />
</section>

<style>
  .hero-code {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: -1;
    width: 8.5rem;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    opacity: 0.55;
  }

  :global(.dark) .hero-code {
    opacity: 0.45;
  }

  /* Bleed through main's padding to the viewport edge. */
  .hero-code--left {
    left: -1rem;
    -webkit-mask-image:
      linear-gradient(to right, #000 0%, transparent 82%),
      linear-gradient(to bottom, transparent, #000 15%, #000 85%, transparent);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, #000 0%, transparent 82%),
      linear-gradient(to bottom, transparent, #000 15%, #000 85%, transparent);
    mask-composite: intersect;
  }

  .hero-code--right {
    right: -1rem;
    -webkit-mask-image:
      linear-gradient(to left, #000 0%, transparent 82%),
      linear-gradient(to bottom, transparent, #000 15%, #000 85%, transparent);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to left, #000 0%, transparent 82%),
      linear-gradient(to bottom, transparent, #000 15%, #000 85%, transparent);
    mask-composite: intersect;
  }

  .hero-code--right :global(pre) {
    text-align: right;
  }

  @media (min-width: 640px) {
    .hero-code--left {
      left: -1.5rem;
    }
    .hero-code--right {
      right: -1.5rem;
    }
  }
</style>
