---
import FormattedDate from '@/components/FormattedDate.astro';
import { getRelatedPosts, readingTime, type Post } from '@/lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const related = await getRelatedPosts(post);
---

{
  related.length > 0 && (
    <aside class="mt-10 border-t border-zinc-200 pt-6 dark:border-zinc-800">
      <h2 class="text-sm font-semibold tracking-wider text-zinc-500 uppercase dark:text-zinc-400">
        Keep reading
      </h2>
      <ul class="mt-4 flex flex-col gap-3">
        {related.map((entry) => (
          <li>
            <a
              href={`/blog/${entry.id}/`}
              class="font-medium hover:text-primary-600 dark:hover:text-primary-400"
            >
              {entry.data.title}
            </a>
            <span class="ml-2 text-sm text-zinc-500 dark:text-zinc-400">
              <FormattedDate date={entry.data.date} /> · {readingTime(entry)} min read
            </span>
          </li>
        ))}
      </ul>
    </aside>
  )
}
