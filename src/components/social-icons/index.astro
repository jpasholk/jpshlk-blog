---
/**
 * Social icon link. Blog post MDX imports this by path and passes
 * `kind`, `href`, and `target`, so that prop surface must stay stable.
 */
import AppStoreBadge from './icons/AppStoreBadge.astro';
import BuyMeACoffee from './icons/BuyMeACoffee.astro';
import Github from './icons/Github.astro';
import Instagram from './icons/Instagram.astro';
import LinkIcon from './icons/Link-icon.astro';
import Linkedin from './icons/Linkedin.astro';
import Mail from './icons/Mail.astro';
import Mastodon from './icons/Mastodon.astro';
import SetAppBadge from './icons/SetAppBadge.astro';

const components = {
  mail: Mail,
  github: Github,
  linkedin: Linkedin,
  mastodon: Mastodon,
  link: LinkIcon,
  buymeacoffee: BuyMeACoffee,
  instagram: Instagram,
  appstorebadge: AppStoreBadge,
  setappbadge: SetAppBadge,
};

interface Props {
  kind: keyof typeof components;
  href?: string;
  size?: number;
  target?: string;
  label?: string;
}

const { kind, href, size = 8, target, label } = Astro.props;
const Icon = components[kind];
const isBadge = kind === 'appstorebadge' || kind === 'setappbadge';
// Tailwind can't see dynamically-built class names, so size via style.
const iconStyle = isBadge
  ? 'height: 3rem; width: auto;'
  : `width: ${size * 0.25}rem; height: ${size * 0.25}rem;`;
---

<a
  href={href}
  target={target ?? '_blank'}
  rel={kind === 'mastodon' ? 'me noopener noreferrer' : 'noopener noreferrer'}
  aria-label={label ?? kind}
  class:list={[
    'inline-block transition-colors',
    !isBadge && 'text-zinc-500 hover:text-primary-500 dark:text-zinc-400 dark:hover:text-primary-400',
  ]}
>
  <Icon class="fill-current" style={iconStyle} />
</a>
