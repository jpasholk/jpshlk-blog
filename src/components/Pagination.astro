---
import type { Page } from 'astro';

interface Props {
  page: Page<unknown>;
}

const { page } = Astro.props;
---

{
  page.lastPage > 1 && (
    <nav aria-label="Pagination" class="mt-8 flex items-center justify-between border-t border-zinc-200 pt-6 dark:border-zinc-800">
      {page.url.prev ? (
        <a href={page.url.prev} class="text-sm font-medium text-primary-600 hover:text-primary-500 dark:text-primary-400">
          &larr; Newer posts
        </a>
      ) : (
        <span />
      )}
      <span class="text-sm text-zinc-500 dark:text-zinc-400">
        Page {page.currentPage} of {page.lastPage}
      </span>
      {page.url.next ? (
        <a href={page.url.next} class="text-sm font-medium text-primary-600 hover:text-primary-500 dark:text-primary-400">
          Older posts &rarr;
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}
