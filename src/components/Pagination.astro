---
import type { Page } from 'astro';

interface Props {
  page: Page<unknown>;
}

const { page } = Astro.props;

// paginate() URLs come without trailing slashes; the built pages have
// them, so normalize to avoid a redirect hop on every click.
const withSlash = (url: string | undefined) =>
  url ? (url.endsWith('/') ? url : `${url}/`) : undefined;
const prevUrl = withSlash(page.url.prev);
const nextUrl = withSlash(page.url.next);
---

{
  page.lastPage > 1 && (
    <nav aria-label="Pagination" class="mt-8 flex items-center justify-between border-t border-zinc-200 pt-6 dark:border-zinc-800">
      {prevUrl ? (
        <a href={prevUrl} class="text-sm font-medium text-primary-600 hover:text-primary-500 dark:text-primary-400">
          &larr; Newer posts
        </a>
      ) : (
        <span />
      )}
      <span class="text-sm text-zinc-500 dark:text-zinc-400">
        Page {page.currentPage} of {page.lastPage}
      </span>
      {nextUrl ? (
        <a href={nextUrl} class="text-sm font-medium text-primary-600 hover:text-primary-500 dark:text-primary-400">
          Older posts &rarr;
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}
