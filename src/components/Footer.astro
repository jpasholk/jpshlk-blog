---
import { AUTHOR, SITE, SOCIALS } from '@/config';
import SocialIcon from '@/components/social-icons/index.astro';

const year = new Date().getFullYear();
---

<footer class="mx-auto mt-16 w-full max-w-3xl px-4 pb-8 sm:px-6">
  <div class="flex flex-col items-center gap-4 border-t border-zinc-200 pt-8 dark:border-zinc-800">
    <div class="flex items-center gap-4">
      <SocialIcon kind="github" href={SOCIALS.github} size={6} label="GitHub" />
      <SocialIcon kind="linkedin" href={SOCIALS.linkedin} size={6} label="LinkedIn" />
      <SocialIcon kind="bluesky" href={SOCIALS.bluesky} size={6} label="Bluesky" />
    </div>
    <div class="flex flex-wrap items-center justify-center gap-x-2 text-sm text-zinc-500 dark:text-zinc-400">
      <span>© {year} {AUTHOR.name}</span>
      <span aria-hidden="true">·</span>
      <a href="/links/" class="hover:text-primary-500">Links</a>
      <span aria-hidden="true">·</span>
      <a href="/how-this-site-works/" class="hover:text-primary-500">How this site works</a>
      <span aria-hidden="true">·</span>
      <a href="/search/" class="hover:text-primary-500">Search</a>
      <span aria-hidden="true">·</span>
      <a href="/archive/" class="hover:text-primary-500">Archive</a>
      <span aria-hidden="true">·</span>
      <a href="/rss.xml" class="hover:text-primary-500">RSS</a>
      <span aria-hidden="true">·</span>
      <a href={SITE.repo} target="_blank" rel="noopener noreferrer" class="hover:text-primary-500">Source</a>
    </div>
  </div>
</footer>
