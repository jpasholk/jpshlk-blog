---
/**
 * Mobile/tablet slice of the code-in-the-margins effect: a short horizontal
 * band of the site's own source with fog patches in the page background
 * color, melting into the page at its top and bottom edges. Hidden at xl
 * and up, where CodeGutters' full-height side columns take over.
 *
 * Purely ornamental: hidden from assistive tech and search, non-interactive,
 * no client JS.
 */
import GutterCode from '@/components/GutterCode.astro';

interface Props {
  code: string;
  class?: string;
}

const { code, class: className } = Astro.props;
---

<div class:list={['code-band xl:hidden', className]} aria-hidden="true" data-pagefind-ignore>
  <GutterCode code={code} />
  <div class="band-fog"></div>
</div>

<style>
  .code-band {
    position: relative;
    height: 6.5rem;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    opacity: 0.6;
    /* Soft melt into the page above and below the band. */
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 32%, #000 68%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 32%, #000 68%, transparent);
  }

  :global(.dark) .code-band {
    opacity: 0.5;
  }

  /* Fog patches with soft gaps, so only fragments of code show through. */
  .band-fog {
    position: absolute;
    inset: 0;
    --fog: var(--color-white);
    background:
      radial-gradient(28% 140% at 12% 50%, var(--fog) 0%, var(--fog) 42%, transparent 78%),
      radial-gradient(24% 140% at 52% 45%, var(--fog) 0%, var(--fog) 38%, transparent 74%),
      radial-gradient(28% 140% at 90% 55%, var(--fog) 0%, var(--fog) 42%, transparent 78%);
  }

  :global(.dark) .band-fog {
    --fog: var(--color-zinc-950);
  }
</style>
