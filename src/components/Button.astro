---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  variant?: 'primary' | 'ghost';
}

const { variant = 'primary', class: className, ...rest } = Astro.props;

const variants = {
  primary:
    'bg-primary-600 text-white hover:bg-primary-500 dark:bg-primary-500 dark:hover:bg-primary-400 dark:text-zinc-950',
  ghost:
    'border border-zinc-300 text-zinc-700 hover:border-primary-500 hover:text-primary-600 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-primary-400 dark:hover:text-primary-400',
};
---

<a
  class:list={[
    'inline-flex items-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition-colors',
    variants[variant],
    className,
  ]}
  {...rest}
>
  <slot />
</a>
