---
import FuzzyRedirect from '@jdevalk/astro-seo-graph/FuzzyRedirect.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
---

<BaseLayout title="Page not found" description="That page doesn't exist, but a close match might." noindex>
  <div class="flex flex-col items-center pt-24 pb-16 text-center">
    <p class="text-7xl font-bold tracking-tight text-primary-500">404</p>
    <h1 class="mt-4 text-3xl font-bold tracking-tight">Page not found</h1>
    <p class="mt-3 max-w-md text-zinc-600 dark:text-zinc-400">
      Sorry, the page you're looking for doesn't exist or has moved.
    </p>
    <p class="mt-4 text-lg font-semibold">
      <FuzzyRedirect />
    </p>
    <div class="mt-8 flex gap-3">
      <Button href="/">Go home</Button>
      <Button href="/blog/" variant="ghost">Browse the blog</Button>
    </div>
  </div>
</BaseLayout>
