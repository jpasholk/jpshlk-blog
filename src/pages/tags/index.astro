---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import FormattedDate from '@/components/FormattedDate.astro';
import { getPublishedPosts } from '@/lib/posts';
import { pageGraph } from '@/lib/schema';

const description =
  'Every topic on the blog on one page: a tag cloud sorted by post count, then an A to Z list of each tag with all of its posts.';

const [tags, posts] = await Promise.all([getCollection('tags'), getPublishedPosts()]);

// One enriched list drives both views. getPublishedPosts() is already
// newest first, so each tag's filtered posts keep that order.
const tagged = tags
  .map((tag) => {
    const tagPosts = posts.filter((post) => post.data.tags.some((t) => t.id === tag.id));
    return { id: tag.id, name: tag.data.name, count: tagPosts.length, posts: tagPosts };
  })
  .filter((tag) => tag.count > 0);

const byCount = [...tagged].sort((a, b) => b.count - a.count);
const byName = [...tagged].sort((a, b) => a.name.localeCompare(b.name, 'en'));
---

<BaseLayout title="Tags" description={description} graph={pageGraph('Tags', '/tags/', description)}>
  <header class="pt-10">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Tags</h1>
    <p class="mt-3 max-w-prose text-lg text-zinc-600 dark:text-zinc-400">
      All {byName.length} topics on one page: biggest first in the cloud, then A to Z below with every post under each tag.
    </p>
  </header>
  <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-4">
    {
      byCount.map(({ id, name, count }) => (
        <li>
          <a
            href={`/tags/${id}/`}
            class="text-lg font-medium text-primary-600 hover:text-primary-500 dark:text-primary-400"
          >
            {name}
            <span class="text-sm text-zinc-500 dark:text-zinc-400">({count})</span>
          </a>
        </li>
      ))
    }
  </ul>

  {
    byName.map((tag) => (
      <section>
        <h2 class="mt-12 flex items-baseline gap-3 text-2xl font-bold tracking-tight">
          <a href={`/tags/${tag.id}/`} class="hover:text-primary-600 dark:hover:text-primary-400">
            {tag.name}
          </a>
          <span class="text-sm font-normal text-zinc-500 dark:text-zinc-400">
            {tag.count} {tag.count === 1 ? 'post' : 'posts'}
          </span>
        </h2>
        <ul class="mt-4 flex flex-col gap-3">
          {tag.posts.map((post) => (
            <li class="flex flex-col gap-x-6 sm:flex-row sm:items-baseline">
              <span class="min-w-36 flex-none font-mono text-xs whitespace-nowrap text-zinc-500 dark:text-zinc-400">
                <FormattedDate date={post.data.date} />
              </span>
              <a
                href={`/blog/${post.id}/`}
                class="font-medium text-primary-600 underline-offset-2 hover:underline dark:text-primary-400"
              >
                {post.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <p class="mt-14 mb-4 max-w-prose text-zinc-600 dark:text-zinc-400">
    Prefer one long timeline? The <a href="/archive/" class="font-medium text-primary-600 underline-offset-2 hover:underline dark:text-primary-400">archive</a> lists every post by year. Looking for something specific? <a href="/search/" class="font-medium text-primary-600 underline-offset-2 hover:underline dark:text-primary-400">Search</a> instead.
  </p>
</BaseLayout>
