---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { pageGraph } from '@/lib/schema';

const description =
  'Search everything on this site: blog posts, projects, and the about page. It all runs in your browser, no server involved.';
---

<BaseLayout title="Search" description={description} graph={pageGraph('Search', '/search/', description)}>
  <div class="pt-10">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Search</h1>
    <p class="mt-3 max-w-prose text-lg text-zinc-600 dark:text-zinc-400">
      Looking for something I wrote? Type away.
    </p>

    <div class="mt-8">
      <pagefind-input placeholder="Search posts and pages"></pagefind-input>
      <pagefind-summary></pagefind-summary>
      <pagefind-results></pagefind-results>
    </div>

    <p id="search-fallback" hidden class="mt-8 max-w-prose text-zinc-600 dark:text-zinc-400">
      Search could not load. If this is a local dev server, the index only exists after a build:
      run <code>npm run build</code> and <code>npm run preview</code>.
    </p>
    <noscript>
      <p class="mt-8 max-w-prose text-zinc-600 dark:text-zinc-400">
        Search needs JavaScript. Everything here is also browsable from the
        <a href="/blog/" class="font-medium text-primary-600 underline-offset-2 hover:underline dark:text-primary-400">blog</a>
        and
        <a href="/tags/" class="font-medium text-primary-600 underline-offset-2 hover:underline dark:text-primary-400">tags</a>
        pages.
      </p>
    </noscript>
  </div>
</BaseLayout>

<script>
  // BaseLayout loads the Component UI bundle; the elements above mount
  // themselves. This script only covers the gaps: revealing the
  // fallback when the bundle is missing (dev servers), focusing the
  // input (the component's autofocus attribute only works during
  // initial document parsing, before the bundle has loaded), and
  // prefilling from a ?q= query param, which the components do not
  // read natively.
  function showFallback() {
    document.getElementById('search-fallback')?.removeAttribute('hidden');
  }

  async function initSearchPage() {
    if (!document.getElementById('search-fallback')) return;
    if ((window as any).__pagefindFailed) showFallback();

    await customElements.whenDefined('pagefind-input');
    // Scoped to main: the header's search modal builds its own
    // pagefind-input, which would match an unscoped selector first.
    const field = document.querySelector<HTMLInputElement>('main pagefind-input input');
    if (!field) return;
    field.focus();

    const q = new URLSearchParams(location.search).get('q');
    if (q && !field.value) {
      field.value = q;
      (window as any).PagefindComponents?.getInstanceManager?.()
        .getInstance('default')
        ?.triggerSearch(q);
    }
  }

  document.addEventListener('pagefind:failed', showFallback);
  document.addEventListener('astro:page-load', initSearchPage);
</script>
