---
import BaseLayout from '@/layouts/BaseLayout.astro';
import About from '@/components/home/About.astro';
import Hero from '@/components/home/Hero.astro';
import HobbiesSection from '@/components/home/HobbiesSection.astro';
import LatestPosts from '@/components/home/LatestPosts.astro';
import RandomQuote from '@/components/home/RandomQuote.astro';
import WorkSection from '@/components/home/WorkSection.astro';
import { SITE } from '@/config';
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <Hero />
  <About />
  <WorkSection />
  <HobbiesSection />
  <LatestPosts />
  <RandomQuote />
</BaseLayout>
