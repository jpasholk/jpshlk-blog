---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import LatestPosts from '@/components/home/LatestPosts.astro';
import RandomQuote from '@/components/home/RandomQuote.astro';
import WorkSection from '@/components/home/WorkSection.astro';
import { AUTHOR, SITE } from '@/config';
import { pageGraph } from '@/lib/schema';
---

<BaseLayout
  title={AUTHOR.name}
  description={SITE.description}
  graph={pageGraph(SITE.title, '/', SITE.description)}
>
  <div data-pagefind-body data-pagefind-meta="title:Home">
    <Hero />
    <WorkSection />
  </div>
  <LatestPosts />
  <RandomQuote />
</BaseLayout>
