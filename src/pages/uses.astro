---
/**
 * The /uses page: hardware, apps, and tools, sourced from things
 * already written about on this blog. Adding an item is one object
 * in the `sections` array; `post` links must point at published
 * (non-draft) posts or the build's internal-link validator fails.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Link from '@/components/Link.astro';
import { SOCIALS } from '@/config';
import { pageGraph } from '@/lib/schema';

interface UsesItem {
  name: string;
  url?: string;
  blurb: string;
  post?: string;
}

interface UsesSection {
  title: string;
  intro?: string;
  items: UsesItem[];
}

const description =
  'The hardware, Mac apps, iOS Shortcuts tools, and dev stack I actually use, collected from things I have written about on this blog.';

const sections: UsesSection[] = [
  {
    title: 'Hardware',
    intro:
      'The honest answer right now: a Mac on the desk and an iPhone in my pocket. Exact models and desk gear coming soon.',
    items: [],
  },
  {
    title: 'Mac apps',
    intro: 'The tiny utilities are always the keepers.',
    items: [
      {
        name: 'Ice',
        url: 'https://github.com/jordanbaird/Ice',
        blurb: 'A free, open source menu bar manager that keeps my menu bar from turning into chaos.',
        post: '/blog/ice-macos-menu-bar-manager/',
      },
      {
        name: 'Scroll Reverser',
        url: 'https://pilotmoon.com/scrollreverser/',
        blurb: 'Lets the mouse wheel and the trackpad scroll in different directions. This should 100% be a native feature.',
        post: '/blog/scroll-reverser-a-tiny-mac-app/',
      },
      {
        name: 'UI Actions',
        url: 'https://actions.work/ui-actions',
        blurb: 'Drives any Mac app from Shortcuts by clicking menus and pressing buttons for you.',
        post: '/blog/ui-actions-beta/',
      },
      {
        name: 'Setapp',
        url: 'https://links.jpshlk.com/setapp',
        blurb: 'One subscription, a pile of good Mac apps. My picks: Bartender 5, CleanShot X, PixelSnap 2, Sip, and iStat Menus. Heads up, that link is an affiliate link.',
        post: '/blog/settapp-apps-for-power-users/',
      },
    ],
  },
  {
    title: 'iPhone + Shortcuts',
    items: [
      {
        name: 'Apple Shortcuts',
        blurb: 'Where most of my automation lives, on iPhone and Mac both.',
      },
      {
        name: 'RoutineHub',
        url: SOCIALS.routinehub,
        blurb: 'Where I publish my Shortcuts, including SCSettings. That link goes straight to my profile.',
        post: '/blog/routinehub-podcast-live-review-sessions-5/',
      },
      {
        name: 'Darksun',
        url: 'https://darksunapp.com',
        blurb: 'A Dark Sky inspired weather app, and the forecast app I actually open.',
        post: '/blog/darksun-a-darksky-inspired-weather-app/',
      },
    ],
  },
  {
    title: 'Dev + AI tools',
    items: [
      {
        name: 'Claude Code',
        url: 'https://claude.com/claude-code',
        blurb: "Anthropic's coding agent. It rebuilt this entire site with me, blog posts about that are on the way.",
      },
      {
        name: 'GitHub',
        url: SOCIALS.github,
        blurb: 'Where the code lives, this site included.',
      },
      {
        name: 'Obsidian',
        url: 'https://obsidian.md',
        blurb: 'Plain Markdown notes. I am still early on this one, but it is sticking.',
      },
    ],
  },
  {
    title: "This site's stack",
    items: [
      {
        name: 'Astro',
        url: 'https://astro.build',
        blurb: 'The static site framework this whole site is built on.',
        post: '/blog/learning-astro/',
      },
      {
        name: 'Tailwind CSS',
        url: 'https://tailwindcss.com',
        blurb: 'Utility classes all the way down, v4 with the CSS first config.',
      },
      {
        name: 'MDX',
        url: 'https://mdxjs.com',
        blurb: 'Markdown for posts, with components where a post needs something extra.',
      },
      {
        name: 'Netlify',
        url: 'https://www.netlify.com',
        blurb: 'Builds and hosts the site. Branch deploys made the rebuild painless.',
      },
      {
        name: '@jdevalk/astro-seo-graph',
        url: 'https://www.npmjs.com/package/@jdevalk/astro-seo-graph',
        blurb: "The Yoast founder's SEO toolkit: JSON-LD, llms.txt, and validators that fail my build when I mess up.",
      },
    ],
  },
];

const h2 = 'mt-14 text-2xl font-bold tracking-tight';
const intro = 'mt-3 max-w-prose text-zinc-600 dark:text-zinc-400';
const blurb = 'mt-1 max-w-prose text-zinc-600 dark:text-zinc-400';
const nameLink = 'font-semibold text-primary-600 hover:text-primary-500 dark:text-primary-400';
const postLink = 'font-medium text-primary-600 underline-offset-2 hover:underline dark:text-primary-400';
---

<BaseLayout title="Uses" description={description} graph={pageGraph('Uses', '/uses/', description)}>
  <header class="pt-10">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">What I use</h1>
    <p class="mt-3 max-w-prose text-lg text-zinc-600 dark:text-zinc-400">
      The apps, tools, and gear I reach for every day. I didn't brainstorm this
      list; it's collected from things I've already written about here, so most
      items link to the post where I said more.
    </p>
  </header>

  {
    sections.map((section) => (
      <section>
        <h2 class={h2}>{section.title}</h2>
        {section.intro && <p class={intro}>{section.intro}</p>}
        {section.items.length > 0 && (
          <ul class="mt-6 space-y-6">
            {section.items.map((item) => (
              <li>
                {item.url ? (
                  <Link href={item.url} class={nameLink}>
                    {item.name}
                  </Link>
                ) : (
                  <span class="font-semibold">{item.name}</span>
                )}
                <p class={blurb}>
                  {item.blurb}
                  {item.post && (
                    <>
                      {' '}
                      <a href={item.post} class={postLink}>
                        I wrote about it.
                      </a>
                    </>
                  )}
                </p>
              </li>
            ))}
          </ul>
        )}
      </section>
    ))
  }

  <p class="mt-14 mb-4 max-w-prose text-zinc-600 dark:text-zinc-400">
    Curious how the stack section fits together? The full tour is at{' '}
    <a href="/how-this-site-works/" class={postLink}>how this site works</a>.
  </p>
</BaseLayout>
