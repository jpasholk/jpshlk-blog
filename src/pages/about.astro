---
/**
 * The /about page: who I am, what I'm doing now, and what I use, all
 * in one place. Absorbed the old homepage About section, the /now
 * page, and the /uses page (both of those URLs redirect here).
 * `post` links must point at published (non-draft) posts or the
 * build's internal-link validator fails.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import FormattedDate from '@/components/FormattedDate.astro';
import Link from '@/components/Link.astro';
import { SOCIALS } from '@/config';
import { pageGraph } from '@/lib/schema';

interface UsesItem {
  name: string;
  url?: string;
  blurb: string;
  post?: string;
}

interface UsesSection {
  title: string;
  intro?: string;
  items: UsesItem[];
}

const updated = new Date('2026-07-17');

const description =
  "Who I am, what I'm doing right now, and the hardware, apps, and tools I actually use. The whole me page, gathered in one place.";

const usesSections: UsesSection[] = [
  {
    title: 'Hardware',
    intro:
      'The honest answer right now: a Mac on the desk and an iPhone in my pocket. Exact models and desk gear coming soon.',
    items: [],
  },
  {
    title: 'Mac apps',
    intro: 'The tiny utilities are always the keepers.',
    items: [
      {
        name: 'Ice',
        url: 'https://github.com/jordanbaird/Ice',
        blurb: 'A free, open source menu bar manager that keeps my menu bar from turning into chaos.',
        post: '/blog/ice-macos-menu-bar-manager/',
      },
      {
        name: 'Scroll Reverser',
        url: 'https://pilotmoon.com/scrollreverser/',
        blurb: 'Lets the mouse wheel and the trackpad scroll in different directions. This should 100% be a native feature.',
        post: '/blog/scroll-reverser-a-tiny-mac-app/',
      },
      {
        name: 'UI Actions',
        url: 'https://actions.work/ui-actions',
        blurb: 'Drives any Mac app from Shortcuts by clicking menus and pressing buttons for you.',
        post: '/blog/ui-actions-beta/',
      },
      {
        name: 'Setapp',
        url: 'https://links.jpshlk.com/setapp',
        blurb: 'One subscription, a pile of good Mac apps. My picks: Bartender 5, CleanShot X, PixelSnap 2, Sip, and iStat Menus. Heads up, that link is an affiliate link.',
        post: '/blog/settapp-apps-for-power-users/',
      },
    ],
  },
  {
    title: 'iPhone + Shortcuts',
    items: [
      {
        name: 'Apple Shortcuts',
        blurb: 'Still handy for quick iPhone and Mac automation, though I build with it less than I used to.',
      },
      {
        name: 'RoutineHub',
        url: SOCIALS.routinehub,
        blurb: 'Where I publish my Shortcuts, including SCSettings. That link goes straight to my profile.',
        post: '/blog/routinehub-podcast-live-review-sessions-5/',
      },
      {
        name: 'Darksun',
        url: 'https://darksunapp.com',
        blurb: 'A Dark Sky inspired weather app, and the forecast app I actually open.',
        post: '/blog/darksun-a-darksky-inspired-weather-app/',
      },
    ],
  },
  {
    title: 'Dev + AI tools',
    items: [
      {
        name: 'Claude Code',
        url: 'https://claude.com/claude-code',
        blurb: "Anthropic's coding agent. It rebuilt this entire site with me, blog posts about that are on the way.",
      },
      {
        name: 'GitHub',
        url: SOCIALS.github,
        blurb: 'Where the code lives, this site included.',
      },
      {
        name: 'Obsidian',
        url: 'https://obsidian.md',
        blurb: 'Plain Markdown notes, over a year deep now, and lately the vault I am building Claude Code skills to work with.',
      },
    ],
  },
  {
    title: "This site's stack",
    items: [
      {
        name: 'Astro',
        url: 'https://astro.build',
        blurb: 'The static site framework this whole site is built on.',
        post: '/blog/learning-astro/',
      },
      {
        name: 'Tailwind CSS',
        url: 'https://tailwindcss.com',
        blurb: 'Utility classes all the way down, v4 with the CSS first config.',
      },
      {
        name: 'MDX',
        url: 'https://mdxjs.com',
        blurb: 'Markdown for posts, with components where a post needs something extra.',
      },
      {
        name: 'Netlify',
        url: 'https://www.netlify.com',
        blurb: 'Builds and hosts the site. Branch deploys made the rebuild painless.',
      },
      {
        name: '@jdevalk/astro-seo-graph',
        url: 'https://www.npmjs.com/package/@jdevalk/astro-seo-graph',
        blurb: "The Yoast founder's SEO toolkit: JSON-LD, llms.txt, and validators that fail my build when I mess up.",
      },
    ],
  },
];

const h2 = 'mt-16 text-2xl font-bold tracking-tight';
const h3 = 'mt-10 text-xl font-bold tracking-tight';
const body = 'mt-3 max-w-prose text-zinc-600 dark:text-zinc-400';
const blurb = 'mt-1 max-w-prose text-zinc-600 dark:text-zinc-400';
const inlineLink = 'text-primary-600 hover:text-primary-500 dark:text-primary-400';
const nameLink = 'font-semibold text-primary-600 hover:text-primary-500 dark:text-primary-400';
const postLink = 'font-medium text-primary-600 underline-offset-2 hover:underline dark:text-primary-400';
---

<BaseLayout title="About" description={description} graph={pageGraph('About', '/about/', description)}>
  <div data-pagefind-body>
    <header class="pt-10">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">About me</h1>
    </header>

    <div class="mt-6 max-w-prose space-y-4 leading-relaxed text-zinc-600 dark:text-zinc-400">
      <p>
        I like to spend my time with family and friends, and enjoy good times,
        bad jokes, hot coffee, and cold beer. When I'm not working or hanging
        out with my lovely girlfriend, I can be found playing pool or disc golf.
      </p>
      <p>
        At work I run operations for our Amazon and Shopify based business. Some
        days that's marketing strategy, others it's helping develop new products
        or keeping the warehouse and logistics moving. Then there's the times
        I'll have to put out a fire because some online service doesn't want to
        work (I don't blame them, I really don't either). 😜
      </p>
      <p>
        In the free-ish time that I can find, I'm usually going deeper on AI:
        building <Link href="https://code.claude.com/docs/en/skills" class={inlineLink}>Claude Skills</Link>,
        plugins, and agents. I've kept my notes in <Link href="https://obsidian.md" class={inlineLink}>Obsidian</Link> for
        over a year now, and lately I wired Claude Code into the vault and
        started building my own skills, some to work with my notes and some for
        everything else. I'm also building this very site with <Link href="https://astro.build" class={inlineLink}>Astro</Link>.
      </p>
      <p>
        I love chatting about e-commerce, marketing, Shopify, and anything tech
        related really. So hit me up if you'd like! 🤙
      </p>
    </div>

    <section id="now">
      <h2 class={h2}>What I'm doing now</h2>
      <p class={body}>
        The current snapshot, in the <Link href="https://nownownow.com/about" class={postLink}>now page</Link> spirit.
        Last updated <FormattedDate date={updated} />.
      </p>

      <h3 class={h3}>Working on</h3>
      <p class={body}>
        Running operations at Plantonix, keeping an Amazon and Shopify based
        business humming. Same as always, never the same twice.
      </p>
      <p class={body}>
        And this site. I rebuilt the whole thing from scratch with an AI pair
        programmer, and I'm still riding that momentum: <a href="/blog/rebuilding-my-blog-with-ai/" class={postLink}>the rebuild series</a> is
        being written and published as I go, and new features keep landing
        (smooth page transitions being the latest).
      </p>

      <h3 class={h3}>Playing with</h3>
      <p class={body}>
        <Link href="https://claude.com/claude-code" class={postLink}>Claude Code</Link> for
        basically everything on this site, and <Link href="https://obsidian.md" class={postLink}>Obsidian</Link> for
        notes (over a year in now, and I recently wired Claude Code into the
        vault). iOS Shortcuts are on the back burner these days, but they're
        what first got me into programming.
      </p>

      <h3 class={h3}>Life lately</h3>
      <p class={body}>
        Time with family, friends, and my girlfriend, who I just moved into a
        new place with. We started a garden this year, which is a funny thing to
        do for a living and then come home to. When I get a free evening it
        usually goes to pool or disc golf, hot coffee or cold beer nearby
        depending on the hour.
      </p>
    </section>

    <section id="uses">
      <h2 class={h2}>What I use</h2>
      <p class={body}>
        The apps, tools, and gear I reach for every day. I didn't brainstorm
        this list; it's collected from things I've already written about here,
        so most items link to the post where I said more.
      </p>

      {
        usesSections.map((section) => (
          <section>
            <h3 class={h3}>{section.title}</h3>
            {section.intro && <p class={body}>{section.intro}</p>}
            {section.items.length > 0 && (
              <ul class="mt-6 space-y-6">
                {section.items.map((item) => (
                  <li>
                    {item.url ? (
                      <Link href={item.url} class={nameLink}>
                        {item.name}
                      </Link>
                    ) : (
                      <span class="font-semibold">{item.name}</span>
                    )}
                    <p class={blurb}>
                      {item.blurb}
                      {item.post && (
                        <>
                          {' '}
                          <a href={item.post} class={postLink}>
                            I wrote about it.
                          </a>
                        </>
                      )}
                    </p>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))
      }
    </section>

    <p class="mt-14 mb-4 max-w-prose text-zinc-600 dark:text-zinc-400">
      Curious how the stack section fits together? The full tour is at{' '}
      <a href="/how-this-site-works/" class={postLink}>how this site works</a>.
    </p>
  </div>
</BaseLayout>
