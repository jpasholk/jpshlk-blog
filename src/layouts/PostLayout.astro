---
import { getImage, Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CodeCopy from '@/components/CodeCopy.astro';
import Comments from '@/components/Comments.astro';
import FormattedDate from '@/components/FormattedDate.astro';
import Prose from '@/components/Prose.astro';
import RelatedPosts from '@/components/RelatedPosts.astro';
import TagPill from '@/components/TagPill.astro';
import type { MarkdownHeading } from 'astro';
import { readingTime, type Post } from '@/lib/posts';
import { postDateModified, postGraph } from '@/lib/schema';
import { assetBase } from '@/lib/urls';

interface Props {
  post: Post;
  prev?: Post;
  next?: Post;
  headings?: MarkdownHeading[];
}

const { post, prev, next, headings = [] } = Astro.props;

// "On this page" only earns its space on longer posts: three or more
// h2 sections. h3s render nested under their h2.
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = tocHeadings.filter((h) => h.depth === 2).length >= 3;
const { title, date, lastmod, summary, tags, seo, featureImage, canonicalUrl } = post.data;

// Share images are generated at build time from one full-size source.
// Never upscale small legacy images, and stay on PNG/JPEG: some link
// preview crawlers still choke on WebP/AVIF.
const ogSource = seo?.image?.src ?? featureImage?.src;
const ogImage = ogSource
  ? await getImage({
      src: ogSource,
      width: Math.min(1200, ogSource.width),
      format: ogSource.format === 'png' ? 'png' : 'jpeg',
    })
  : undefined;
---

<BaseLayout
  title={seo?.title ?? title}
  description={seo?.description ?? summary}
  canonical={canonicalUrl}
  ogType="article"
  ogImage={ogImage
    ? new URL(ogImage.src, assetBase).href
    : new URL(`/og/${post.id}.png`, assetBase).href}
  ogImageAlt={ogSource ? (seo?.image?.alt ?? featureImage?.alt ?? title) : title}
  ogImageWidth={ogImage?.attributes.width ?? 1200}
  ogImageHeight={ogImage?.attributes.height ?? 630}
  article={{
    publishedTime: date,
    modifiedTime: postDateModified(post),
    tags: tags.map((tag) => tag.id),
  }}
  graph={postGraph(post)}
>
  <article class="pt-10" data-pagefind-body>
    {
      featureImage && (
        <Image
          src={featureImage.src}
          alt={featureImage.alt ?? title}
          width={1400}
          class="mb-8 rounded-xl"
          loading="eager"
          data-vt-name={`post-image-${post.id}`}
          data-vt-detail
        />
      )
    }
    <header class="border-b border-zinc-200 pb-8 text-center dark:border-zinc-800">
      <p class="text-sm font-medium text-zinc-500 dark:text-zinc-400" data-pagefind-ignore>
        <FormattedDate date={date} />
        <span aria-hidden="true"> · </span>{readingTime(post)} min read
        {
          lastmod && (
            <>
              <span aria-hidden="true"> · </span>
              updated <FormattedDate date={lastmod} />
            </>
          )
        }
      </p>
      <h1
        class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl"
        data-vt-name={`post-title-${post.id}`}
        data-vt-detail
      >
        {title}
      </h1>
      {
        tags.length > 0 && (
          <p class="mt-3">
            {tags.map((tag) => (
              <TagPill slug={tag.id} />
            ))}
          </p>
        )
      }
    </header>

    {
      showToc && (
        <details
          class="mt-8 rounded-xl border border-zinc-200 bg-zinc-50 px-4 py-3 dark:border-zinc-800 dark:bg-zinc-900"
          data-pagefind-ignore
        >
          <summary class="cursor-pointer text-sm font-semibold">On this page</summary>
          <ul class="mt-2 flex flex-col gap-1 text-sm">
            {tocHeadings.map((heading) => (
              <li class={heading.depth === 3 ? 'pl-4' : ''}>
                <a
                  href={`#${heading.slug}`}
                  class="text-primary-600 underline-offset-2 hover:underline dark:text-primary-400"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </details>
      )
    }

    <div class="py-8">
      <Prose>
        <slot />
      </Prose>
    </div>
  </article>

  <RelatedPosts post={post} />

  {
    (prev || next) && (
      <nav
        aria-label="Post navigation"
        class="flex flex-col gap-4 border-t border-zinc-200 pt-6 sm:flex-row sm:justify-between dark:border-zinc-800"
      >
        {prev ? (
          <a
            href={`/blog/${prev.id}/`}
            class="max-w-xs text-sm font-medium text-primary-600 hover:text-primary-500 dark:text-primary-400"
          >
            &larr; {prev.data.title}
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a
            href={`/blog/${next.id}/`}
            class="max-w-xs text-sm font-medium text-primary-600 hover:text-primary-500 sm:text-right dark:text-primary-400"
          >
            {next.data.title} &rarr;
          </a>
        )}
      </nav>
    )
  }

  {post.data.comments && <Comments />}

  <CodeCopy />

  <!-- Renders <a class="github-button"> markers used by some posts; -->
  <!-- data-astro-rerun re-parses them after ClientRouter swaps. -->
  <script is:inline data-astro-rerun async src="https://buttons.github.io/buttons.js"></script>
</BaseLayout>
