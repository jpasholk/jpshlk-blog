---
import '@/styles/global.css';
import { ClientRouter, fade } from 'astro:transitions';
import Seo from '@jdevalk/astro-seo-graph/Seo.astro';
import CodeGutters from '@/components/CodeGutters.astro';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import { GOATCOUNTER, SITE, SOCIALS } from '@/config';
import { assetBase } from '@/lib/urls';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  canonical?: string;
  ogType?: 'website' | 'article' | 'profile' | 'book';
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  article?: {
    publishedTime?: Date;
    modifiedTime?: Date;
    tags?: string[];
  };
  graph?: Record<string, unknown> | null;
}

const {
  title,
  description = SITE.description,
  noindex = false,
  canonical,
  ogType = 'website',
  ogImage = new URL('/og-default.png', assetBase).href,
  ogImageAlt = SITE.title,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  article,
  graph,
} = Astro.props;

const goatcounter =
  GOATCOUNTER.enabled && GOATCOUNTER.code
    ? `https://${GOATCOUNTER.code}.goatcounter.com/count`
    : null;
---

<!doctype html>
<html lang="en" transition:animate={fade({ duration: '0.2s' })}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <script is:inline>
      // Apply the theme before first paint, and again after every
      // ClientRouter swap (the new document arrives without the class).
      (() => {
        const apply = () => {
          const stored = localStorage.getItem('theme');
          const dark = stored
            ? stored === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
          // Pagefind's Component UI keys its dark scheme off this attribute.
          document.documentElement.dataset.pfTheme = dark ? 'dark' : 'light';
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>

    {
      goatcounter && (
        <>
          <script is:inline>
            // GoatCounter under ClientRouter: swaps are not real page
            // loads, so automatic counting is off and each pageview is
            // counted on astro:page-load, which fires on the first load
            // and after every swap. The listener survives swaps because
            // the document object is never replaced. No data-astro-rerun:
            // rerunning would stack listeners and double count.
            window.goatcounter = { no_onload: true };
            document.addEventListener('astro:page-load', () => {
              if (window.goatcounter.count) {
                window.goatcounter.count({ path: location.pathname + location.search });
              }
            });
          </script>
          <script is:inline defer data-goatcounter={goatcounter} src="https://gc.zgo.at/count.js"></script>
        </>
      )
    }

    <Seo
      title={title}
      titleTemplate={title === SITE.title ? '%s' : `%s | ${SITE.title}`}
      description={description}
      canonical={canonical}
      ogType={ogType}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      ogImageWidth={ogImageWidth}
      ogImageHeight={ogImageHeight}
      siteName={SITE.title}
      locale="en_US"
      noindex={noindex}
      article={article}
      graph={graph}
      extraLinks={[
        { rel: 'icon', type: 'image/svg+xml', href: '/favicon.svg' },
        { rel: 'icon', type: 'image/png', href: '/favicon.png' },
        { rel: 'apple-touch-icon', sizes: '180x180', href: '/static/favicons/apple-touch-icon.png' },
        { rel: 'manifest', href: '/static/favicons/site.webmanifest' },
        { rel: 'sitemap', href: '/sitemap-index.xml' },
        { rel: 'alternate', type: 'application/rss+xml', title: SITE.title, href: '/rss.xml' },
        { rel: 'me', href: SOCIALS.mastodon },
      ]}
      extraMeta={[
        { name: 'theme-color', media: '(prefers-color-scheme: light)', content: '#ffffff' },
        { name: 'theme-color', media: '(prefers-color-scheme: dark)', content: '#09090b' },
      ]}
    />

    <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />

    <ClientRouter />
  </head>
  <body class="relative">
    <CodeGutters />
    <div class="relative z-10 flex min-h-screen flex-col">
      <a
        href="#main"
        class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-primary-600 focus:px-4 focus:py-2 focus:text-white"
      >
        Skip to content
      </a>
      <Header />
      <main id="main" class="mx-auto w-full max-w-3xl grow px-4 sm:px-6">
        <slot />
      </main>
      <Footer />
    </div>

    <script>
      // Fills the home page's RandomQuote. Lives here instead of in the
      // component so the astro:before-swap listener is loaded on EVERY
      // page: the quote must be written into the incoming document
      // before ClientRouter swaps it in, or it pops in visibly after
      // the crossfade when navigating home from any other page.
      function showRandomQuote(doc: Document) {
        const container = doc.querySelector('[data-random-quote]');
        const data = doc.querySelector('[data-quotes]');
        if (!container || !data?.textContent) return;
        const quotes: Array<{ text: string; author: string }> = JSON.parse(data.textContent);
        const quote = quotes[Math.floor(Math.random() * quotes.length)];
        if (!quote) return;
        container.querySelector('[data-quote-text]')!.textContent = `“${quote.text}”`;
        container.querySelector('[data-quote-author]')!.textContent = `— ${quote.author}`;
      }

      showRandomQuote(document);
      document.addEventListener('astro:before-swap', (e) => {
        showRandomQuote((e as Event & { newDocument: Document }).newDocument);
      });
    </script>

    <script>
      // Loads Pagefind's Component UI once per browsing session. The
      // custom elements self-register and auto-mount whenever they
      // appear in the DOM (including after ClientRouter swaps), so no
      // init call is needed. The bundle only exists in the built site
      // (dist/pagefind/); in dev the load fails, the flag is set, and
      // the search page reveals its fallback message. Until (or unless)
      // the elements are defined, CSS hides them entirely.
      async function loadPagefindComponents() {
        const w = window as any;
        if (w.PagefindComponents || w.__pagefindFailed) return;
        try {
          await new Promise((resolve, reject) => {
            const s = document.createElement('script');
            s.src = '/pagefind/pagefind-component-ui.js';
            s.onload = resolve;
            s.onerror = reject;
            document.head.append(s);
          });
        } catch {
          w.__pagefindFailed = true;
          document.dispatchEvent(new CustomEvent('pagefind:failed'));
        }
      }

      // Pagefind's instance registry lives on window and survives
      // ClientRouter swaps, but it never drops components that leave
      // the DOM. Without this pruning, the header's modal trigger
      // keeps opening the PREVIOUS page's dead modal ("The element is
      // not in a Document"). Drop every registration and hook whose
      // element is no longer connected; the swapped-in elements have
      // already re-registered by the time astro:page-load fires.
      function prunePagefindRegistry() {
        const manager = (window as any).PagefindComponents?.getInstanceManager?.();
        if (!manager?.getInstance) return;
        const live = (c: unknown) => !(c instanceof Element) || c.isConnected;
        for (const name of ['default', 'modal']) {
          const instance = manager.getInstance(name);
          if (!instance) continue;
          if (Array.isArray(instance.components)) {
            instance.components = instance.components.filter(live);
          }
          for (const type of Object.keys(instance.componentsByType ?? {})) {
            if (Array.isArray(instance.componentsByType[type])) {
              instance.componentsByType[type] = instance.componentsByType[type].filter(live);
            }
          }
          for (const event of Object.keys(instance.__hooks__ ?? {})) {
            if (Array.isArray(instance.__hooks__[event])) {
              instance.__hooks__[event] = instance.__hooks__[event].filter(
                (entry: { owner?: unknown }) => typeof entry === 'function' || live(entry?.owner),
              );
            }
          }
        }
      }

      document.addEventListener('astro:page-load', () => {
        prunePagefindRegistry();
        loadPagefindComponents();
      });
    </script>
  </body>
</html>
