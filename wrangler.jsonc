{
  // Cloudflare Workers static-assets config. Connect the repo via
  // Workers Builds (or Cloudflare Pages — same static output).
  // Build command: npm run build
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jpshlk-blog",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
